{
  "name": "lg-tv-control",
  "version": "0.1.9",
  "description": "LG webOS TV controls and display-gated Steam Deck power automation",
  "type": "module",
  "license": "BSD-3-Clause",
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c -w",
    "typecheck": "tsc --noEmit",
    "test": "python3 -m unittest discover -s tests -v",
    "package": "pnpm build && python3 scripts/package.py",
    "dev": "node scripts/dev.mjs",
    "dev:backend": "python3 scripts/local_server.py",
    "typecheck:local": "tsc -p dev/tsconfig.json --noEmit",
    "build:local": "vite build --config dev/vite.config.js",
    "dev:ui": "vite --config dev/vite.config.js"
  },
  "devDependencies": {
    "@decky/rollup": "^1.0.2",
    "@decky/ui": "^4.11.0",
    "@types/react": "19.1.1",
    "@types/react-dom": "19.1.1",
    "@types/react-router": "5.1.20",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "rollup": "^4.53.3",
    "typescript": "^5.6.2",
    "vite": "^7"
  },
  "dependencies": {
    "@decky/api": "^1.1.3",
    "react-icons": "^5.3.0",
    "tslib": "^2.7.0"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [
        "react",
        "react-dom"
      ]
    }
  }
}
